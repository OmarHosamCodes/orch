# Environment Configuration for Orch
# ========================================
# Copy this file to create .env files in each app:
#   - cp .env.example apps/server/.env
#   - cp .env.example apps/web/.env
#
# IMPORTANT: NEVER commit .env files — they contain secrets and are .gitignored
# Each .env file can override these values per environment

# ========== DATABASE ==========
# PostgreSQL connection string
# Default (Docker): postgresql://postgres:password@localhost:5440/orch
DATABASE_URL="postgresql://postgres:password@localhost:5440/orch"

# ========== AUTHENTICATION ==========
# Better Auth secret key (used for JWT signing)
# Must be at least 32 characters. Generate with: openssl rand -hex 16
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"

# Better Auth URL (public URL where browsers reach auth endpoints)
# Development: http://localhost:7001 (Vite proxies /api/auth to the API on :7000)
# Production: https://brainiac.school-of-marketing.com (web server proxies /api/auth to the API)
# Alias domain https://orch.school-of-marketing.com must also be listed in CORS_ORIGINS
BETTER_AUTH_URL="http://localhost:7001"

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========== CORS & FRONTEND ==========
# Allowed origin for CORS requests
# Development: http://localhost:7001 (where the Vite dev server runs)
# Production: https://orch.school-of-marketing.com (canonical)
CORS_ORIGIN="http://localhost:7001"
# Optional: comma-separated additional frontend origins, e.g. alias domains
# Production: https://brainiac.school-of-marketing.com (alias, shared cookies)
# CORS_ORIGINS="https://brainiac.school-of-marketing.com"

# Frontend server URL (used in frontend env)
# Development: http://localhost:7000 (direct API) or leave unset when using the Vite proxy
# Production (single Railway service): leave unset — the browser uses window.location.origin
VITE_PUBLIC_SERVER_URL="http://localhost:7000"

# ========== SENTRY ==========
# Shared DSN for the single Orch Sentry project (web + server).
# Leave unset locally to keep the SDKs disabled.
VITE_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Optional overrides; production defaults to NODE_ENV / Railway git SHA.
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""
# Build-time source map upload (never commit real tokens):
# SENTRY_ORG="school-of-marketing"
# SENTRY_PROJECT="orch"
# SENTRY_AUTH_TOKEN=""

# ========== AI / LLM ==========
# OpenRouter API key for AI model access
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ========== BILLING / PAYMENTS ==========
# Polar payment processing (optional, only needed for billing features)

# Polar API token for accessing payment API
POLAR_ACCESS_TOKEN="polar_oat_your-token-here"

# Polar webhook secret for validating webhooks
POLAR_WEBHOOK_SECRET="polar_whs_your-secret-here"

# Polar environment: "sandbox" for testing, "production" for real payments
POLAR_SERVER="sandbox"

# Agency SKU (fallback if POLAR_PRODUCT_AGENCY is unset)
POLAR_PRODUCT_PRO="ee8722e7-7ea2-4040-a8d7-d32bdfcd03e9"
# Optional explicit Agency id (same product as POLAR_PRODUCT_PRO in production)
# POLAR_PRODUCT_AGENCY="ee8722e7-7ea2-4040-a8d7-d32bdfcd03e9"
# Agency Unlimited
POLAR_PRODUCT_AGENCY_UNLIMITED="a72406dd-cd21-416e-a443-a395d01bf2e3"
# Orch credit pack
POLAR_PRODUCT_ORCH_CREDITS="db04a245-5b14-417d-a579-afc372f92e6b"

# ========== S3-COMPATIBLE STORAGE ==========
# Used for agency task attachments. Do not commit real credentials.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="orch-task-attachments"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# ========== REDIS ==========
# Used for agency task thread live sync (pub/sub)
REDIS_URL="redis://localhost:6379"

# ========== ENVIRONMENT ==========
# Runtime environment: "development", "production", or "test"
NODE_ENV="development"
