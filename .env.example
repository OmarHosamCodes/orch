# Orch environment template
# Copy to .env (local) or .env.production (Railway). Never commit filled copies.

# ========== RUNTIME ==========
NODE_ENV="development"
# Production only (Railway start script):
# PORT="7001"
# INTERNAL_API_PORT="3001"

# ========== DATABASE ==========
DATABASE_URL="postgresql://postgres:password@localhost:5440/orch"
REDIS_URL="redis://localhost:6379"

# ========== AUTH ==========
# BETTER_AUTH_SECRET must be at least 32 characters (openssl rand -hex 16)
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:7001"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
CORS_ORIGIN="http://localhost:7001"
# Production alias:
# CORS_ORIGINS="https://brainiac.school-of-marketing.com"

# ========== BILLING (Polar Sandbox) ==========
# Dashboard: https://sandbox.polar.sh/dashboard/som-test
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN="polar_oat_your-token-here"
POLAR_WEBHOOK_SECRET="polar_whs_your-secret-here"
POLAR_PRODUCT_PRO="87f3b254-73d5-4c52-a725-c721697cb909"
POLAR_PRODUCT_AGENCY="87f3b254-73d5-4c52-a725-c721697cb909"
POLAR_PRODUCT_AGENCY_UNLIMITED="7b04151a-5c76-470d-bc94-89636b2075e6"
POLAR_PRODUCT_ORCH_CREDITS="e1942925-b2ad-464e-b97f-7f44ba42f8e9"

# Live Polar catalog when POLAR_SERVER=production:
# POLAR_PRODUCT_PRO="ee8722e7-7ea2-4040-a8d7-d32bdfcd03e9"
# POLAR_PRODUCT_AGENCY="ee8722e7-7ea2-4040-a8d7-d32bdfcd03e9"
# POLAR_PRODUCT_AGENCY_UNLIMITED="a72406dd-cd21-416e-a443-a395d01bf2e3"
# POLAR_PRODUCT_ORCH_CREDITS="db04a245-5b14-417d-a579-afc372f92e6b"

# ========== STORAGE ==========
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="orch-task-attachments"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
BUCKET_CORS_ORIGINS="http://localhost:7001,http://localhost:7000"

# ========== WEB PUSH ==========
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# ========== AI ==========
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ========== SENTRY ==========
# Leave empty locally to disable. Production needs DSN + upload token.
VITE_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# SENTRY_ORG="school-of-marketing"
# SENTRY_PROJECT="orch"
# SENTRY_ENVIRONMENT="development"
# SENTRY_AUTH_TOKEN=""

# ========== FRONTEND ==========
VITE_PUBLIC_SERVER_URL="http://localhost:7000"
VITE_PUBLIC_VAPID_KEY=""
# Production: omit VITE_PUBLIC_SERVER_URL (same-origin).
