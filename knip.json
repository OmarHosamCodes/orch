{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": [
    "apps/web/perf/check-filters.mjs",
    "apps/web/src/components/elements/thread-list.tsx",
    "apps/web/src/components/elements/thread-search.tsx",
    "apps/web/src/components/marketing/bits/GradualBlur.tsx",
    "apps/web/src/components/marketing/bits/WebThreads.tsx",
    "apps/web/src/components/marketing/landing-features-index.tsx",
    "apps/web/src/components/originkit/ui/reflect-shader.tsx",
    "apps/web/src/features/app-shell/app-shell-chrome.tsx",
    "apps/web/src/features/app-shell/app-shell-notifications.tsx",
    "apps/web/src/features/notifications/agency-notifications.tsx",
    "apps/web/src/features/notifications/featured-rail-alerts.tsx",
    "apps/web/src/features/notifications/featured-rail-notification.tsx",
    "apps/web/src/features/task-management/my-tasks-rail/agency-my-tasks-rail.tsx"
  ],
  "ignoreIssues": {
    "apps/web/**": [
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "namespaceMembers",
      "duplicates"
    ]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-conventions.mjs",
        "scripts/check-golden-file-inventory.mjs",
        "scripts/check-realtime-registry.mjs",
        "scripts/generate-golden-file-inventory.mjs",
        "scripts/perf/run-benchmarks.mjs",
        "scripts/railway-start.mjs",
        "scripts/test-setup.ts",
        ".railway/railway.ts"
      ],
      "project": ["scripts/**/*.{ts,mjs}", ".railway/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/**/*.{test,spec}.{ts,tsx}",
        "src/ui/**/*.{ts,tsx}",
        "vite.config.ts",
        "scripts/write-railway-server.mjs",
        "scripts/railway-ssr-server.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "vite*.ts", "scripts/**/*.mjs", "perf/**/*.mjs"],
      "ignoreDependencies": [
        "@tanstack/react-query-devtools",
        "@tanstack/react-router-devtools",
        "tailwindcss",
        "tw-animate-css",
        "tw-shimmer",
        "shadcn"
      ]
    },
    "apps/server": {
      "entry": [
        "src/index.ts",
        "src/**/*.{test,spec}.ts",
        "src/operations/seeds/seed.ts",
        "src/operations/seeds/seed-agency.ts",
        "src/operations/seeds/seed-massive.ts",
        "src/operations/seeds/record-film-clips.ts",
        "src/operations/seeds/seed-film-agency.ts",
        "src/operations/imports/import-clockify.ts",
        "src/operations/backfills/import-clockify-backfill.ts",
        "src/operations/backfills/backfill-entity-icons.ts",
        "src/operations/backfills/backfill-canvas-named-brains.ts",
        "src/operations/backfills/verify-clockify-backfill.ts",
        "src/operations/backfills/verify-agency-clone.ts",
        "src/operations/maintenance/clear-team-data.ts",
        "src/operations/maintenance/cleanup-agency-operator-nodes.ts",
        "src/operations/maintenance/grant-lifetime-pro.ts",
        "src/operations/local-reset-team-passwords.ts",
        "src/operations/local-timer-smoke.ts",
        "tsdown.config.ts"
      ],
      "project": ["src/**/*.ts", "tsdown.config.ts"],
      "ignoreDependencies": ["sharp", "@sentry/cli"]
    },
    "packages/agent": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "drizzle.config.ts"]
    },
    "packages/env": {
      "entry": ["src/server.ts", "src/vite.ts", "src/web.ts", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/workspace": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": ["src/assert-never.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
