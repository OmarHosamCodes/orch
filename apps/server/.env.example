# Server Environment Configuration
# ==================================
# Backend (Hono + oRPC) specific environment variables
# Copy this file: cp .env.example .env
# Then fill in your values

# ========== DATABASE ==========
# PostgreSQL connection string
# Development (Docker): postgresql://postgres:password@localhost:5440/orch
DATABASE_URL="postgresql://postgres:password@localhost:5440/orch"

# ========== AUTHENTICATION ==========
# Better Auth secret (used for signing JWTs)
# Generate: openssl rand -hex 16
BETTER_AUTH_SECRET="your-32-char-secret-key-here-min"

# Better Auth public URL (public URL where browsers reach auth endpoints)
# Development: http://localhost:7001 (Vite proxies /api/auth to the API on :7000)
# Production: https://brainiac.school-of-marketing.com (web server proxies /api/auth to the API)
# Alias domain https://orch.school-of-marketing.com must also be listed in CORS_ORIGINS
BETTER_AUTH_URL="http://localhost:7001"

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========== CORS ==========
# Allowed origin for CORS requests from frontend
# Development: http://localhost:7001 (where the Vite dev server runs)
# Production: https://orch.school-of-marketing.com (canonical)
CORS_ORIGIN="http://localhost:7001"
# Optional comma-separated extra origins (alias domains) for CORS and Better Auth
# Production: https://brainiac.school-of-marketing.com (alias, shared cookies)
# CORS_ORIGINS="https://brainiac.school-of-marketing.com"

# ========== AI / LLM ==========
# OpenRouter API key for accessing AI models
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"

# ========== PAYMENTS ==========
# Polar payment processor tokens (required if billing is enabled)

# Polar API token
POLAR_ACCESS_TOKEN="polar_oat_your-token-here"

# Polar webhook secret
POLAR_WEBHOOK_SECRET="polar_whs_your-secret-here"

# Polar environment: "sandbox" (testing) or "production"
POLAR_SERVER="sandbox"

# Polar product ID for Pro tier subscription
POLAR_PRODUCT_PRO="bc88ffdc-8153-44c8-aad3-b1d0fdae446f"
# Optional Polar product id for Orch credit packs (one-time checkout)
# POLAR_PRODUCT_ORCH_CREDITS="your-orch-credits-product-id"

# ========== S3-COMPATIBLE STORAGE ==========
# Used for agency task attachments. Do not commit real credentials.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="orch-task-attachments"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# ========== REDIS ==========
# Used for agency task thread live sync (pub/sub)
REDIS_URL="redis://localhost:6379"

# ========== WEB PUSH ==========
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# ========== SENTRY ==========
# Shared DSN for the single Orch Sentry project. Leave empty to disable locally.
SENTRY_DSN=""
# Optional overrides; production defaults to NODE_ENV / RAILWAY_GIT_COMMIT_SHA.
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""
# Build-time source map upload (never commit real tokens):
# SENTRY_ORG="school-of-marketing"
# SENTRY_PROJECT="orch"
# SENTRY_AUTH_TOKEN=""

# ========== ENVIRONMENT ==========
# Runtime environment mode
NODE_ENV="development"

# HTTP port for the API server (default: 7000)
# PORT="7000"

# ========== SEEDING (optional) ==========
# Scale for db:seed scripts: default | massive
# BRAINIAC_SEED_SCALE="default"

# Password for seeded demo accounts (default: orch1234)
# BRAINIAC_SEED_PASSWORD="orch1234"
